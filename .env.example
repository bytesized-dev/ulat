# Copy to .env.local. Nothing here is secret, the app runs fully offline.

# Where Ollama runs. Teammates without a local Ollama use CJ's Tailscale address.
OLLAMA_URL=http://localhost:11434

# The ffmpeg that turns voice notes into WAV for the model. Defaults to Homebrew's, then the one on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# The SQLite file. Defaults to data/ulat.db.
# DATABASE_PATH=data/ulat.db

# Caddy reads this, not the app. Set it in the shell that starts Caddy, see infra/README.md.
# HUB_DOMAIN=hub.example.dev
